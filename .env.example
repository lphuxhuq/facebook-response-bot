# Facebook Response Bot V2 Environment Variables

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Control Plane
# Generate a strong random token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production: guards POST /pause, /resume (audit finding S3)
ADMIN_API_TOKEN=change_me_strong_random_admin_token
# Start the bot already paused (true/false)
BOT_ENABLED=true

# Meta Messenger Platform Configuration (Official Page transport)
FACEBOOK_PAGE_ID=123456789012345
FACEBOOK_APP_ID=123456789012345
FACEBOOK_APP_SECRET=your_app_secret_here
FACEBOOK_VERIFY_TOKEN=your_custom_webhook_verify_token
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Bot Core Settings
BOT_NAME="Facebook Response Bot V2"
BOT_PREFIX="!"
BOT_OWNER_ID=100000000000001

# Storage
DATABASE_PATH=./data/bot.sqlite

# Personal account session (Phase 5 transport)
# 32-byte (64 hex chars) key used by AES-256-GCM session store.
# REQUIRED when NODE_ENV=production — the app fails fast without it (audit S4).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Encrypted session file location (kept out of git via data/ in .gitignore)
FB_SESSION_PATH=./data/facebook/session/session.enc

# Optional AI Providers (for AI Plugin)
AI_PROVIDER=gemini # options: gemini, openai, openrouter, mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Optional External APIs
OPENWEATHER_API_KEY=
